<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Movie Website</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
</head>

<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-info">
    <a class="navbar-brand" href="#">Movies</a>

    <div class="ml-auto">
        <ul class="navbar-nav d-inline">
            <li class="nav-item d-inline"><a class="nav-link d-inline text-white" href="#">About</a></li>
            <li class="nav-item d-inline"><a class="nav-link d-inline text-white" href="#">Showtimes</a></li>
            <li class="nav-item d-inline"><a class="nav-link d-inline text-white" href="#">Deals</a></li>
        </ul>
    </div>
</nav>

<!-- Showtimes Section -->
<div class="container mt-4">
    <h2>Showtimes:</h2>

    <div class="row">

        <!-- Card 1 -->
        <div class="col-md-4">
            <div class="card">
                <img src="image1.jpg" class="card-img-top" alt="Kong">
                <div class="card-body">
                    <h5>Kong Skull Island</h5>
                    <p>AA team of scientists, risking their lives to explore the untouched islands. Home to the great Kong, and must fight to escape the beast.</p>

                    <span class="badge badge-warning">1:00pm</span>
                    <span class="badge badge-warning">3:00pm</span>
                    <span class="badge badge-warning">5:30pm</span>
                    <span class="badge badge-warning">7:00pm</span>
                </div>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="col-md-4">
            <div class="card">
                <img src="image2.jpg" class="card-img-top" alt="Ghost">
                <div class="card-body">
                    <h5>Ghost in the Shell</h5>
                    <p>A cyber-enhanced human fights crime in the future.An army major, the first cyber-human , explores the unknown.</p>

                    <span class="badge badge-warning">1:00pm</span>
                    <span class="badge badge-warning">3:00pm</span>
                    <span class="badge badge-warning">5:00pm</span>
                    <span class="badge badge-warning">7:00pm</span>
                </div>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="col-md-4">
            <div class="card">
                <img src="image3.jpg" class="card-img-top" alt="Beauty">
                <div class="card-body">
                    <h5>Beauty and the Beast</h5>
                    <p>A prince must learn love to break a curse.</p>

                    <span class="badge badge-warning">1:00pm</span>
                    <span class="badge badge-warning">3:00pm</span>
                    <span class="badge badge-warning">5:00pm</span>
                    <span class="badge badge-warning">9:00pm</span>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Signup Section -->
<div class="container text-center mt-5">
    <h2 class="text-primary">SIGN UP FOR WEEKLY MOVIE CLUBS</h2>

    <form class="mt-3">
        <input type="email" class="form-control w-50 mx-auto" placeholder="Enter email">
        <br>
        <button class="btn btn-primary">Submit</button>
    </form>
</div>

<!-- Footer -->
<footer class="bg-light text-center mt-5 p-3">
    <p>© 2026 Movie Website</p>
</footer>

</body>
</html>
