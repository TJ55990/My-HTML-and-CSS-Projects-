<!DOCTYPE html>
<html lang="en">
<head>
<style>
.gallery-img {
  cursor: pointer;
  margin: 10px;
}

.lightbox {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.9);
}

#lightbox-img {
  display: block;
  margin: auto;
  max-width: 80%;
  margin-top: 50px;
}

.close {
  position: absolute;
  top: 20px;
  right: 30px;
  color: white;
  font-size: 40px;
  cursor: pointer;
}
</style>
    <meta charset="UTF-8">
    <title>My First Webpage</title>
</head>
<script src="JS/one_page_website.js"></script>
<body>

<!-- Navigation -->
<nav>
    <a href="#home">Home</a> |
    <a href="#images">Images</a> |
    <a href="#video">Video</a> |
    <a href="#contact">Contact</a>
</nav>

<hr>

<!-- Home Section -->
<h1 id="home">Welcome to My Webpage</h1>
<p>This is my first webpage. It has a combination of images, videos, text and contact form</p>

<hr>

<!-- Images Section -->
<h2 id="images">My Pictures</h2>
<img src="image1-small.jpg" alt="Picture 1" width="250">
<img src="image2-small.jpg" alt="Picture 2" width="250">
<img src="image3-small.jpg" alt="Picture 3" width="250">
<p>The images are for demonstartion purposes only</p>

<hr>

<!-- Video Section -->
<h2 id="video">My Video</h2>
<iframe width="400" height="225" src= "https://www.youtube.com/watch?v=4uTv7ZTpnvc" frameborder="0" allowfullscreen></iframe>
<p>This is a sample video brought from from YouTube.</p>

<hr>

<!-- Contact Form Section -->
<h2 id="contact">Contact Me</h2>
<form>
    Name:<br>
    <input type="text" name="name"><br><br>

    Email:<br>
    <input type="email" name="email"><br><br>

    Message:<br>
    <textarea name="message" rows="4" cols="30"></textarea><br><br>

    <input type="submit" value="Send">
</form>

<hr>

<!-- Footer -->
<footer>
    <p>© 2026 My First Website</p>
</footer>

<div id="lightbox" class="lightbox">
   <span class="close">&times:</span>
   <img id="lightbox-img">
<div>

</body>
</html>
