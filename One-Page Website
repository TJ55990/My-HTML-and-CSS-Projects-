<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My First Webpage</title>
</head>
<body>

<!-- Navigation -->
<nav>
    <a href="#home">Home</a> |
    <a href="#images">Images</a> |
